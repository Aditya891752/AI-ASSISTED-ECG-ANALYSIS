*.zip
*.tar.gz
*.tar.bz2

# ── Model files — keep small models, ignore large ones ───────────────────────
# model/*.pkl and model/*.pt ARE committed (they're the trained weights)
# Add specific ignores only if files exceed GitHub's 100 MB limit
# model/model_combined_rf.pkl  ← 15 MB, safe to commit

# ── Logs & temp ───────────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

