# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="PS-03 ECG Screening API"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ─── API ──────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_UPLOAD_SIZE_MB=50

# ─── Database (TimescaleDB / PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ecg:ecgpassword@localhost:5432/ecgdb

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=360

# ─── Model ────────────────────────────────────────────────────────────────────
MODEL_PATH=model/model.pkl
# MODEL_PATH=model/model.pt      # Uncomment for PyTorch

# ─── ECG Processing ───────────────────────────────────────────────────────────
ECG_SAMPLE_RATE=360
ECG_STREAM_BUFFER_SIZE=1800
ECG_BATCH_SIZE=256

# ─── Cache ────────────────────────────────────────────────────────────────────
RESULT_CACHE_TTL=300
MODEL_CACHE_TTL=3600

# ─── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_SCREEN=60/minute
RATE_LIMIT_BATCH=10/minute

# ─── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
